ed); padding: 8px 20px; border-radius: 20px; font-weight: 700!important; box-shadow: 0 0 15px var(--accent-red-glow); }\n\n.content { padding: 140px 20px 80px; max-width: 1200px; margin: 0 auto; text-align: center; }\n.hero-section { margin-bottom: 50px; }\n.age-pill { display: inline-block; padding: 6px 16px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 20px; }\n.hero-title { font-size: 4rem; font-weight: 900; letter-spacing: 3px; }\n.gradient-text { background: linear-gradient(135deg, #fff 30%, var(--accent-red)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n.hero-subtitle { color: var(--text-muted); font-size: 1.2rem; margin-top: 12px; max-width: 600px; margin-left: auto; margin-right: auto; }\n.section-heading { font-size: 1.8rem; letter-spacing: 2px; margin-bottom: 30px; color: #ffffff; }\n\n/* Clean 2-Card Row Layout */\n.apple-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 24px;\n    text-align: left;\n    max-width: 900px;\n    margin: 0 auto;\n}\n\n@media (max-width: 768px) {\n    .apple-grid {\n        grid-template-columns: 1fr;\n    }\n}\n\n.apple-card {\n    position: relative;\n    background: var(--glass-bg);\n    border: 1px solid var(--glass-border);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border-radius: 28px;\n    padding: 32px;\n    text-decoration: none;\n    color: #ffffff;\n    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    min-height: 240px;\n    opacity: 1;\n    visibility: visible;\n}\n\n.apple-card:hover {\n    transform: translateY(-8px) scale(1.02);\n    border-color: var(--accent-red);\n    background: rgba(30, 36, 50, 0.95);\n    box-shadow: 0 20px 40px rgba(0,0,0,0.6), 0 0 30px var(--accent-red-glow);\n}\n\n.card-number { font-size: 0.85rem; font-weight: 800; color: var(--accent-red); }\n.card-title { font-size: 1.8rem; font-weight: 800; margin: 10px 0 6px; color: #ffffff; }\n.card-tagline { font-size: 0.95rem; color: var(--text-muted); line-height: 1.4; }\n.card-arrow { align-self: flex-end; font-size: 1.4rem; color: var(--accent-red); transition: transform 0.3s ease; }\n.apple-card:hover .card-arrow { transform: translateX(6px); }\n\n/* Sport Page Sub-Panel */\n.sport-page { min-height: 100vh; background-size: cover; background-position: center; background-attachment: fixed; display: flex; align-items: center; justify-content: center; padding: 120px 20px 60px; }\n.sport-container { max-width: 900px; width: 100%; }\n.apple-glass-panel { background: rgba(10, 11, 16, 0.88); border: 1px solid var(--glass-border); backdrop-filter: blur(30px); border-radius: 36px; padding: 48px; box-shadow: 0 40px 80px rgba(0,0,0,0.9); }\n.category-pill { font-size: 0.75rem; font-weight: 800; color: var(--accent-red); letter-spacing: 2px; }\n.sport-title-hero { font-size: 3.5rem; font-weight: 900; margin: 8px 0; color: #ffffff; }\n.tagline-sub { font-size: 1.2rem; color: var(--text-muted); }\n\n.panel-body { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 36px 0; }\n.info-card-bubble { background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border); border-radius: 24px; padding: 24px; backdrop-filter: blur(10px); }\n.bubble-icon { font-size: 1.8rem; margin-bottom: 12px; }\n.info-card-bubble h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: #ffffff; }\n.info-card-bubble p, .info-card-bubble ul { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }\n.info-card-bubble ul { list-style-position: inside; }\n\n.panel-footer { text-align: center; margin-top: 20px; }\n.btn-primary-glow { display: inline-block; padding: 16px 36px; background: var(--accent-red); color: #ffffff; text-decoration: none; font-weight: 800; b