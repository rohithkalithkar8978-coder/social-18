I0815 17:32:41.864059    2221 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/rohithkalithkar/templates/index.html","version":7},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"rangeLength":0,"text":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n    \u003ctitle\u003eSOCIAL 18 — Next-Gen Athletics\u003c/title\u003e\n    \u003clink rel=\"stylesheet\" href=\"/static/style.css\"\u003e\n    \n    \u003c!-- Animation \u0026 3D Libraries --\u003e\n    \u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"\u003e\u003c/script\u003e\n    \u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"\u003e\u003c/script\u003e\n    \u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"\u003e\u003c/script\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003c!-- Fixed 3D Canvas Background --\u003e\n    \u003ccanvas id=\"canvas3d\" style=\"position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none;\"\u003e\u003c/canvas\u003e\n\n    \u003cheader class=\"navbar\"\u003e\n        \u003cdiv class=\"logo\"\u003eSOCIAL \u003cspan\u003e18\u003c/span\u003e\u003c/div\u003e\n        \u003cnav class=\"nav-links\"\u003e\n            \u003ca href=\"#sports\"\u003eSports Arena\u003c/a\u003e\n            \u003ca href=\"#about\"\u003eAbout\u003c/a\u003e\n            \u003ca href=\"#community\" class=\"btn-glow\"\u003eJoin Now\u003c/a\u003e\n        \u003c/nav\u003e\n    \u003c/header\u003e\n\n    \u003cmain class=\"content\"\u003e\n        \u003c!-- Hero Section --\u003e\n        \u003csection class=\"hero-section\" id=\"hero\"\u003e\n            \u003ch1 class=\"hero-title\"\u003eNEXT-GEN \u003cspan\u003eATHLETICS\u003c/span\u003e\u003c/h1\u003e\n            \u003cp class=\"hero-subtitle\"\u003eScroll down to explore interactive 3D training arenas.\u003c/p\u003e\n        \u003c/section\u003e\n\n        \u003c!-- Sports Selector Section --\u003e\n        \u003csection class=\"sports-section\" id=\"sports\"\u003e\n            \u003ch2\u003eSelect Your Sport\u003c/h2\u003e\n            \u003cdiv class=\"sports-grid\"\u003e\n                \u003cbutton class=\"sport-btn active\" onclick=\"loadSport('boxing')\"\u003eBoxing\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('running')\"\u003eRunning\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('cycling')\"\u003eCycling\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('cricket')\"\u003eCricket\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('powerlifting')\"\u003ePowerlifting\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('badminton')\"\u003eBadminton\u003c/button\u003e\n                \u003cbutton class=\"sport-btn\" onclick=\"loadSport('tennis')\"\u003eTennis\u003c/button\u003e\n            \u003c/div\u003e\n\n            \u003cdiv id=\"sport-details\" class=\"details-card\"\u003e\n                \u003ch3 id=\"sport-title\"\u003eBoxing\u003c/h3\u003e\n                \u003cp id=\"sport-importance\"\u003eCrucial for explosive cardiovascular endurance, reflexes, and mental resilience.\u003c/p\u003e\n                \n                \u003ch4\u003eKey Benefits:\u003c/h4\u003e\n                \u003cul id=\"sport-benefits\"\u003e\n                    \u003cli\u003eEnhanced hand-eye coordination\u003c/li\u003e\n                    \u003cli\u003eCore stability \u0026 power\u003c/li\u003e\n                    \u003cli\u003eAgility and defensive reflexes\u003c/li\u003e\n                \u003c/ul\u003e\n\n                \u003ch4\u003eArrangements:\u003c/h4\u003e\n                \u003cp id=\"sport-arrangements\"\u003eWeekly sparring sessions at central arenas, certified coaching, and weight-class brackets.\u003c/p\u003e\n            \u003c/div\u003e\n        \u003c/section\u003e\n    \u003c/main\u003e\n\n    \u003cscript\u003e\n        // -------------------------------------------------------------\n        // 1. THREE.JS \u0026 GSAP SCROLL-DRIVEN 3D SCENE SETUP\n        // -------------------------------------------------------------\n        gsap.registerPlugin(ScrollTrigger);\n\n        const canvas = document.getElementById('canvas3d');\n        const scene = new THREE.Scene();\n        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n        const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });\n\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n        // Create 3D Geometric Object (Icosahedron wireframe)\n        const geometry = new THREE.IcosahedronGeometry(1.8, 1);\n        const material = new THREE.MeshPhysicalMaterial({\n            color: 0x00f0ff,\n            wireframe: true,\n            transparent: true,\n            opacity: 0.6,\n            roughness: 0.1\n        });\n        const mesh = new THREE.Mesh(geometry, material);\n        scene.add(mesh);\n\n        // Lights\n        const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);\n        scene.add(ambientLight);\n        const dirLight = new THREE.DirectionalLight(0xffffff, 2);\n        dirLight.position.set(5, 5, 5);\n        scene.add(dirLight);\n\n        camera.position.z = 4.5;\n\n        // Map Vertical Page Scroll directly to 3D Mesh Rotation \u0026 Scale\n        gsap.to(mesh.rotation, {\n            y: Math.PI * 4,\n            x: Math.PI * 2,\n            scrollTrigger: {\n                trigger: \"body\",\n                start: \"top top\",\n                end: \"bottom bottom\",\n                scrub: 1.5\n            }\n        });\n\n        gsap.to(mesh.scale, {\n            x: 1.4,\n            y: 1.4,\n            z: 1.4,\n            scrollTrigger: {\n                trigger: \"body\",\n                start: \"top top\",\n                end: \"bottom bottom\",\n                scrub: 1.5\n            }\n        });\n\n        // Continuous Loop \u0026 Window Resizing\n        function animate() {\n            requestAnimationFrame(animate);\n            mesh.rotation.z += 0.003;\n            renderer.render(scene, camera);\n        }\n        animate();\n\n        window.addEventListener('resize', () =\u003e {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        // -------------------------------------------------------------\n        // 2. FLASK API FETCH FUNCTIONALITY\n        // -------------------------------------------------------------\n        async function loadSport(sportName) {\n            // Update UI button highlights\n            document.querySelectorAll('.sport-btn').forEach(btn =\u003e btn.classList.remove('active'));\n            event.target.classList.add('active');\n\n            try {\n                const response = await fetch(`/api/sport/${sportName}`);\n                const data = await response.json();\n\n                if (data.error) return;\n\n                document.getElementById('sport-title').innerText = data.title;\n                document.getElementById('sport-importance').innerText = data.importance;\n                document.getElementById('sport-arrangements').innerText = data.arrangements;\n\n                const benefitsList = document.getElementById('sport-benefits');\n                benefitsList.innerHTML = '';\n                data.benefits.forEach(benefit =\u003e {\n                    const li = document.createElement('li');\n                    li.innerText = benefit;\n                    benefitsList.appendChild(li);\n                });\n            } catch (err) {\n                console.error(\"Failed to load sport data:\", err);\n            }\n        }\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"}]}
