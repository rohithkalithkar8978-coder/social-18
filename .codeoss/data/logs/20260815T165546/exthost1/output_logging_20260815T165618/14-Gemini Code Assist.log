I0815 18:10:18.585480    4664 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/rohithkalithkar/static/style.css","version":43},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"rangeLength":0,"text":":root {\n    --bg-dark: #0a0b10;\n    --glass-bg: rgba(22, 27, 38, 0.95);\n    --glass-border: rgba(255, 255, 255, 0.18);\n    --accent-red: #ff2a2a;\n    --accent-red-glow: rgba(255, 42, 42, 0.4);\n    --text-main: #ffffff;\n    --text-muted: #cbd5e1;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }\n\nbody { background-color: var(--bg-dark); color: var(--text-main); overflow-x: hidden; }\n\n/* Fixed Navbar Positioning */\n.navbar {\n    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);\n    width: 90%; max-width: 1200px; display: flex; justify-content: space-between; align-items: center;\n    padding: 14px 28px; background: rgba(10, 11, 16, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\n    border: 1px solid var(--glass-border); border-radius: 50px; z-index: 1000;\n}\n\n.logo-group { display: flex; align-items: center; gap: 12px; }\n.logo { font-size: 1.5rem; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }\n.highlight-red { color: var(--accent-red); }\n.age-badge {\n    font-size: 0.7rem; font-weight: 800; background: rgba(255, 42, 42, 0.2); border: 1px solid var(--accent-red);\n    color: var(--accent-red); padding: 4px 10px; border-radius: 12px; letter-spacing: 1px;\n}\n\n.nav-links a, .btn-back { color: #ffffff; text-decoration: none; font-weight: 600; font-size: 0.95rem; }\n.btn-back { background: rgba(255,255,255,0.08); padding: 8px 18px; border-radius: 20px; transition: 0.3s; border: 1px solid var(--glass-border); }\n.btn-back:hover { background: var(--accent-red); border-color: var(--accent-red); }\n.btn-glow { background: var(--accent-red); padding: 8px 20px; border-radius: 20px; font-weight: 700!important; box-shadow: 0 0 15px var(--accent-red-glow); }\n\n.content { padding: 140px 20px 80px; max-width: 1200px; margin: 0 auto; text-align: center; }\n.hero-section { margin-bottom: 50px; }\n.age-pill { display: inline-block; padding: 6px 16px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 20px; }\n.hero-title { font-size: 4rem; font-weight: 900; letter-spacing: 3px; }\n.gradient-text { background: linear-gradient(135deg, #fff 30%, var(--accent-red)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n.hero-subtitle { color: var(--text-muted); font-size: 1.2rem; margin-top: 12px; max-width: 600px; margin-left: auto; margin-right: auto; }\n.section-heading { font-size: 1.8rem; letter-spacing: 2px; margin-bottom: 30px; color: #ffffff; }\n\n/* 2-Column Grid Layout */\n.apple-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 24px;\n    text-align: left;\n    max-width: 900px;\n    margin: 0 auto;\n}\n\n@media (max-width: 768px) {\n    .apple-grid { grid-template-columns: 1fr; }\n}\n\n.apple-card, .apple-card:visited, .apple-card:active, .apple-card:focus {\n    position: relative; background: var(--glass-bg) !important; border: 1px solid var(--glass-border) !important;\n    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-radius: 28px; padding: 32px;\n    text-decoration: none !important; color: #ffffff !important; display: flex; flex-direction: column;\n    justify-content: space-between; min-height: 240px; opacity: 1 !important; visibility: visible !important;\n    outline: none; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\n}\n\n.apple-card:hover { transform: translateY(-6px); border-color: var(--accent-red) !important; background: rgba(30, 36, 50, 0.98) !important; box-shadow: 0 15px 35px rgba(0,0,0,0.7), 0 0 25px var(--accent-red-glow); }\n.card-number { font-size: 0.85rem; font-weight: 800; color: var(--accent-red) !important; }\n.card-title { font-size: 1.8rem; font-weight: 800; margin: 10px 0 6px; color: #ffffff !important; }\n.card-tagline { font-size: 0.95rem; color: var(--text-muted) !important; line-height: 1.4; }\n.card-arrow { align-self: flex-end; font-size: 1.4rem; color: var(--accent-red) !important; transition: transform 0.3s ease; }\n.apple-card:hover .card-arrow { transform: translateX(6px); }\n\n/* Clean Detail Page Spacing \u0026 Typography */\n.sport-page {\n    min-height: 100vh;\n    background-size: cover;\n    background-position: center;\n    background-attachment: fixed;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 140px 20px 60px; /* Increased top padding to prevent navbar overlap */\n}\n\n.sport-container { max-width: 900px; width: 100%; }\n\n.apple-glass-panel {\n    background: rgba(10, 11, 16, 0.92);\n    border: 1px solid var(--glass-border);\n    backdrop-filter: blur(30px);\n    border-radius: 36px;\n    padding: 48px;\n    box-shadow: 0 40px 80px rgba(0,0,0,0.9);\n}\n\n.category-pill { font-size: 0.75rem; font-weight: 800; color: var(--accent-red); letter-spacing: 2px; }\n.sport-title-hero { font-size: 3.5rem; font-weight: 900; margin: 12px 0 6px; color: #ffffff !important; }\n.tagline-sub { font-size: 1.2rem; color: var(--text-muted) !important; }\n\n.panel-body { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 36px 0; }\n.info-card-bubble { background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border); border-radius: 24px; padding: 24px; backdrop-filter: blur(10px); }\n.bubble-icon { font-size: 1.8rem; margin-bottom: 12px; }\n.info-card-bubble h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: #ffffff !important; }\n.info-card-bubble p, .info-card-bubble ul { color: var(--text-muted) !important; font-size: 0.95rem; line-height: 1.6; }\n.info-card-bubble ul { list-style-position: inside; }\n\n.panel-footer { text-align: center; margin-top: 28px; }\n\n/* Visible Glow Button */\n.btn-primary-glow {\n    display: inline-block;\n    padding: 16px 36px;\n    background: var(--accent-red) !important;\n    color: #ffffff !important;\n    text-decoration: none !important;\n    font-weight: 800;\n    border-radius: 30px;\n    box-shadow: 0 0 25px var(--accent-red-glow);\n    transition: all 0.3s ease;\n}\n\n.btn-primary-glow:hover {\n    transform: scale(1.04);\n    box-shadow: 0 0 35px rgba(255, 42, 42, 0.8);\n}"}]}
