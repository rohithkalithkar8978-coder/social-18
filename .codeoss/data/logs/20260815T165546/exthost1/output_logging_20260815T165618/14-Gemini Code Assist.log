I0815 18:57:39.673029    5937 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/rohithkalithkar/templates/index.html","version":23},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"rangeLength":0,"text":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n    \u003ctitle\u003eSOCIAL 18 — Free Event Registration\u003c/title\u003e\n    \u003clink rel=\"stylesheet\" href=\"/static/style.css\"\u003e\n    \u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"\u003e\u003c/script\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader class=\"navbar\"\u003e\n        \u003cdiv class=\"logo-group\"\u003e\n            \u003cspan class=\"logo\"\u003eSOCIAL \u003cspan class=\"highlight-red\"\u003e18\u003c/span\u003e\u003c/span\u003e\n            \u003cspan class=\"age-badge\"\u003eAGES 14–18 ONLY\u003c/span\u003e\n        \u003c/div\u003e\n        \u003cnav class=\"nav-links\"\u003e\n            \u003ca href=\"#sports\"\u003eDisciplines\u003c/a\u003e\n            \u003cbutton type=\"button\" class=\"btn-glow\" onclick=\"openModal()\"\u003eRegister Now\u003c/button\u003e\n        \u003c/nav\u003e\n    \u003c/header\u003e\n\n    \u003cmain class=\"content\"\u003e\n        {% with messages = get_flashed_messages(with_categories=true) %}\n          {% if messages %}\n            {% for category, message in messages %}\n              \u003cdiv class=\"alert-box\"\u003e{{ message }}\u003c/div\u003e\n            {% endfor %}\n          {% endif %}\n        {% endwith %}\n\n        \u003csection class=\"hero-section\"\u003e\n            \u003cdiv class=\"age-pill\"\u003eFREE ATHLETIC MEETUP — AGES 14–18 ONLY\u003c/div\u003e\n            \u003ch1 class=\"hero-title\"\u003ePUSH YOUR \u003cspan class=\"gradient-text\"\u003eLIMITS\u003c/span\u003e\u003c/h1\u003e\n            \u003cp class=\"hero-subtitle\"\u003eJoin our free youth sports arena. Select a discipline below or register right away.\u003c/p\u003e\n            \u003cbutton type=\"button\" class=\"btn-primary-glow hero-btn\" onclick=\"openModal()\"\u003eEnroll for Free\u003c/button\u003e\n        \u003c/section\u003e\n\n        \u003csection class=\"sports-section\" id=\"sports\"\u003e\n            \u003ch2 class=\"section-heading\"\u003eFEATURED DISCIPLINES\u003c/h2\u003e\n            \n            \u003cdiv class=\"apple-grid\"\u003e\n                {% for key, sport in sports.items() %}\n                    \u003ca href=\"/sport/{{ key }}\" class=\"apple-card\"\u003e\n                        \u003cspan class=\"card-number\"\u003e0{{ loop.index }}\u003c/span\u003e\n                        \u003ch3 class=\"card-title\"\u003e{{ sport.title }}\u003c/h3\u003e\n                        \u003cp class=\"card-tagline\"\u003e{{ sport.tagline }}\u003c/p\u003e\n                        \u003cdiv class=\"card-arrow\"\u003e→\u003c/div\u003e\n                    \u003c/a\u003e\n                {% endfor %}\n            \u003c/div\u003e\n        \u003c/section\u003e\n    \u003c/main\u003e\n\n    \u003c!-- Registration Modal --\u003e\n    \u003cdiv id=\"regModal\" class=\"modal-overlay\"\u003e\n        \u003cdiv class=\"modal-card\"\u003e\n            \u003cbutton type=\"button\" class=\"modal-close\" onclick=\"closeModal()\"\u003e×\u003c/button\u003e\n            \u003ch2\u003eFREE EVENT REGISTRATION\u003c/h2\u003e\n            \u003cp class=\"modal-sub\"\u003eFill in your details to reserve your spot.\u003c/p\u003e\n            \n            \u003cform action=\"/register\" method=\"POST\" class=\"reg-form\"\u003e\n                \u003cinput type=\"text\" name=\"full_name\" placeholder=\"Full Name\" required\u003e\n                \u003cinput type=\"email\" name=\"email\" placeholder=\"Email Address\" required\u003e\n                \u003cdiv class=\"form-row\"\u003e\n                    \u003cinput type=\"number\" name=\"age\" min=\"14\" max=\"18\" placeholder=\"Age (14-18)\" required\u003e\n                    \u003cinput type=\"tel\" name=\"phone\" placeholder=\"Phone / WhatsApp\" required\u003e\n                \u003c/div\u003e\n                \u003cselect name=\"sport\" required\u003e\n                    \u003coption value=\"\" disabled selected\u003eSelect Sport Discipline\u003c/option\u003e\n                    \u003coption value=\"Boxing\"\u003eBoxing\u003c/option\u003e\n                    \u003coption value=\"Running\"\u003eRunning\u003c/option\u003e\n                    \u003coption value=\"Cycling\"\u003eCycling\u003c/option\u003e\n                    \u003coption value=\"Cricket\"\u003eCricket\u003c/option\u003e\n                    \u003coption value=\"Powerlifting\"\u003ePowerlifting\u003c/option\u003e\n                    \u003coption value=\"Badminton\"\u003eBadminton\u003c/option\u003e\n                    \u003coption value=\"Tennis\"\u003eTennis\u003c/option\u003e\n                \u003c/select\u003e\n                \u003cbutton type=\"submit\" class=\"btn-primary-glow submit-btn\"\u003eConfirm Free Enrollment\u003c/button\u003e\n            \u003c/form\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cscript\u003e\n        function openModal() {\n            document.getElementById('regModal').classList.add('active');\n        }\n        function closeModal() {\n            document.getElementById('regModal').classList.remove('active');\n        }\n\n        document.addEventListener(\"DOMContentLoaded\", () =\u003e {\n            gsap.from(\".hero-section *\", { y: 20, opacity: 0, duration: 0.5, stagger: 0.06, ease: \"power2.out\", clearProps: \"all\" });\n            gsap.from(\".apple-card\", { y: 30, opacity: 0, duration: 0.5, stagger: 0.05, ease: \"power2.out\", clearProps: \"all\" });\n        });\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"}]}
