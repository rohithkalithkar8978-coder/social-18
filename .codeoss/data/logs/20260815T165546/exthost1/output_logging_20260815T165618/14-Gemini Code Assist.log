ATURED DISCIPLINES\u003c/h2\u003e\n            \n            \u003cdiv class=\"apple-grid\"\u003e\n                {% for key, sport in sports.items() %}\n                    \u003ca href=\"/sport/{{ key }}\" class=\"apple-card\"\u003e\n                        \u003cdiv class=\"card-glass-glow\"\u003e\u003c/div\u003e\n                        \u003cspan class=\"card-number\"\u003e0{{ loop.index }}\u003c/span\u003e\n                        \u003ch3 class=\"card-title\"\u003e{{ sport.title }}\u003c/h3\u003e\n                        \u003cp class=\"card-tagline\"\u003e{{ sport.tagline }}\u003c/p\u003e\n                        \u003cdiv class=\"card-arrow\"\u003e→\u003c/div\u003e\n                    \u003c/a\u003e\n                {% endfor %}\n            \u003c/div\u003e\n        \u003c/section\u003e\n    \u003c/main\u003e\n\n    \u003cscript\u003e\n        gsap.from(\".hero-section *\", {\n            y: 50,\n            opacity: 0,\n            duration: 1,\n            stagger: 0.15,\n            ease: \"power4.out\"\n        });\n\n        gsap.from(\".apple-card\", {\n            y: 60,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.1,\n            ease: \"back.out(1.2)\",\n            delay: 0.4\n        });\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"}]}
