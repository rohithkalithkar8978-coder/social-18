                    \u003ctd style=\"padding: 12px 14px;\"\u003e{{ row[0] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px; font-weight: bold;\"\u003e{{ row[1] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px;\"\u003e{{ row[2] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px;\"\u003e{{ row[3] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px;\"\u003e{{ row[4] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px; color: #ff2a2a; font-weight: bold;\"\u003e{{ row[5] }}\u003c/td\u003e\n                    \u003ctd style=\"padding: 12px 14px; color: #cbd5e1; font-size: 0.85rem;\"\u003e{{ row[6] }}\u003c/td\u003e\n                \u003c/tr\u003e\n                {% endfor %}\n            \u003c/tbody\u003e\n        \u003c/table\u003e\n    \u003c/div\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e"}}
