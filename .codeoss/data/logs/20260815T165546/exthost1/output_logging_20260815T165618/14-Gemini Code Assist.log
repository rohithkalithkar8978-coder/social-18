I0815 17:12:58.847405    2221 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didOpen: {"textDocument":{"uri":"file:///home/rohithkalithkar/static/style.css","languageId":"css","version":1,"text":":root {\n  --bg-dark: #07090e;\n  --card-bg: rgba(255, 255, 255, 0.03);\n  --neon-orange: #ff4500;\n  --neon-cyan: #00f0ff;\n  --text-main: #ffffff;\n  --font-family: 'Montserrat', system-ui, sans-serif;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background-color: var(--bg-dark);\n  color: var(--text-main);\n  font-family: var(--font-family);\n}\n\n.navbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 1.2rem 5%;\n  background: rgba(7, 9, 14, 0.9);\n  backdrop-filter: blur(12px);\n  position: fixed;\n  width: 100%;\n  top: 0;\n  z-index: 100;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.logo {\n  font-weight: 900;\n  font-style: italic;\n  font-size: 1.6rem;\n}\n\n.logo span {\n  color: var(--neon-orange);\n}\n\n.age-badge {\n  background: rgba(255, 69, 0, 0.15);\n  border: 1px solid var(--neon-orange);\n  color: var(--neon-orange);\n  padding: 0.3rem 0.8rem;\n  font-size: 0.8rem;\n  font-weight: 700;\n  border-radius: 20px;\n  text-transform: uppercase;\n}\n\nnav a {\n  color: var(--text-main);\n  text-decoration: none;\n  margin: 0 1rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.hero {\n  height: 90vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  padding: 0 1rem;\n  background: radial-gradient(circle at center, rgba(255,69,0,0.15) 0%, transparent 70%);\n}\n\n.hero-content h1 {\n  font-size: 4.5rem;\n  font-style: italic;\n  font-weight: 900;\n  letter-spacing: -1px;\n  background: linear-gradient(90deg, #fff, var(--neon-orange));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  margin: 1rem 0;\n}\n\n.hero-content p {\n  max-width: 600px;\n  margin: 0 auto 2rem;\n  color: #a0a5b5;\n  font-size: 1.1rem;\n}\n\n.tagline {\n  color: var(--neon-cyan);\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  font-size: 0.9rem;\n}\n\n.cta-group {\n  display: flex;\n  justify-content: center;\n  gap: 1rem;\n}\n\n.btn {\n  padding: 0.9rem 2.2rem;\n  font-weight: 800;\n  border-radius: 4px;\n  cursor: pointer;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.btn-primary {\n  background: var(--neon-orange);\n  border: none;\n  color: #fff;\n  box-shadow: 0 0 15px rgba(255, 69, 0, 0.4);\n}\n\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 0 25px rgba(255, 69, 0, 0.7);\n}\n\n.btn-secondary {\n  background: transparent;\n  border: 2px solid var(--text-main);\n  color: var(--text-main);\n}\n\n.sports-section {\n  padding: 4rem 5%;\n  text-align: center;\n}\n\n.sports-section h2 {\n  font-style: italic;\n  font-size: 2rem;\n  margin-bottom: 2rem;\n  text-transform: uppercase;\n}\n\n.sports-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 1.5rem;\n}\n\n.sport-card {\n  background: var(--card-bg);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  padding: 2rem 1rem;\n  border-radius: 8px;\n  font-weight: 800;\n  font-size: 1.2rem;\n  text-transform: uppercase;\n  transition: border-color 0.3s ease;\n}\n\n.sport-card:hover {\n  border-color: var(--neon-cyan);\n}"}}
