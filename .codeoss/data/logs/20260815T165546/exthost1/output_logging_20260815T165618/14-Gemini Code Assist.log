I0815 17:45:30.031673    2221 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/rohithkalithkar/static/style.css","version":14},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"rangeLength":0,"text":":root {\n    --bg-dark: #0a0b10;\n    --card-bg: rgba(15, 23, 42, 0.75);\n    --card-border: rgba(255, 255, 255, 0.15);\n    --text-white: #ffffff;\n    --accent-red: #ff2a2a;\n    --text-muted: #cbd5e1;\n}\n\n* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }\n\nbody { background-color: var(--bg-dark); color: var(--text-white); }\n\n/* Logo: SOCIAL white, 18 Red */\n.logo { font-size: 1.8rem; font-weight: 900; letter-spacing: 2px; color: var(--text-white); text-decoration: none; }\n.highlight-red { color: var(--accent-red); }\n\n.navbar {\n    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);\n    width: 90%; max-width: 1200px; display: flex; justify-content: space-between; align-items: center;\n    padding: 16px 32px; background: rgba(10, 11, 16, 0.7); backdrop-filter: blur(16px);\n    border: 1px solid var(--card-border); border-radius: 50px; z-index: 100;\n}\n\n.nav-links a, .btn-back { color: var(--text-white); text-decoration: none; font-weight: 600; margin-left: 20px; }\n.btn-back { background: rgba(255,255,255,0.1); padding: 8px 16px; border-radius: 20px; transition: 0.3s; }\n.btn-back:hover { background: var(--accent-red); }\n\n/* Hero \u0026 Grid */\n.content { text-align: center; padding: 140px 20px 60px; max-width: 1100px; margin: 0 auto; }\n.hero-title { font-size: 3.5rem; font-weight: 900; margin-bottom: 16px; }\n.sports-grid { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 30px; }\n.sport-card-link { text-decoration: none; }\n.sport-btn {\n    padding: 16px 32px; background: var(--card-bg); border: 1px solid var(--card-border);\n    color: var(--text-white); border-radius: 30px; font-size: 1.2rem; font-weight: 700;\n    transition: all 0.3s ease; backdrop-filter: blur(10px);\n}\n.sport-btn:hover { background: var(--accent-red); transform: translateY(-4px); box-shadow: 0 10px 20px rgba(255, 42, 42, 0.4); }\n\n/* Sport Detail Page with Background Image */\n.sport-page {\n    min-height: 100vh; background-size: cover; background-position: center; background-attachment: fixed;\n    display: flex; align-items: center; justify-content: center; padding: 120px 20px 60px;\n}\n.sport-card-full {\n    background: var(--card-bg); border: 1px solid var(--card-border); backdrop-filter: blur(24px);\n    border-radius: 24px; padding: 40px; max-width: 800px; width: 100%; box-shadow: 0 30px 60px rgba(0,0,0,0.8);\n}\n.sport-title-large { font-size: 3rem; color: var(--accent-red); margin-bottom: 24px; font-weight: 900; }\n.info-block { margin-bottom: 24px; text-align: left; }\n.info-block h3 { font-size: 1.4rem; color: var(--text-white); margin-bottom: 8px; border-bottom: 2px solid var(--accent-red); display: inline-block; }\n.info-block p, .info-block ul { color: var(--text-muted); font-size: 1.1rem; line-height: 1.7; margin-top: 8px; }\n.info-block ul { list-style-position: inside; }"}]}
