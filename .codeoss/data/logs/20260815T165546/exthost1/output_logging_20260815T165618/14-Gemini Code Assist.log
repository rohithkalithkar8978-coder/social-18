rent;\n  margin: 1rem 0;\n}\n\n.hero-content p {\n  max-width: 600px;\n  margin: 0 auto 2rem;\n  color: #a0a5b5;\n  font-size: 1.1rem;\n}\n\n.tagline {\n  color: var(--neon-cyan);\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  font-size: 0.9rem;\n}\n\n.cta-group {\n  display: flex;\n  justify-content: center;\n  gap: 1rem;\n}\n\n.btn {\n  padding: 0.9rem 2.2rem;\n  font-weight: 800;\n  border-radius: 4px;\n  cursor: pointer;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.btn-primary {\n  background: var(--neon-orange);\n  border: none;\n  color: #fff;\n  box-shadow: 0 0 15px rgba(255, 69, 0, 0.4);\n}\n\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 0 25px rgba(255, 69, 0, 0.7);\n}\n\n.btn-secondary {\n  background: transparent;\n  border: 2px solid var(--text-main);\n  color: var(--text-main);\n}\n\n.sports-section {\n  padding: 4rem 5%;\n  text-align: center;\n}\n\n.sports-section h2 {\n  font-style: italic;\n  font-size: 2rem;\n  margin-bottom: 2rem;\n  text-transform: uppercase;\n}\n\n.sports-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 1.5rem;\n}\n\n.sport-card {\n  background: var(--card-bg);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  padding: 2rem 1rem;\n  border-radius: 8px;\n  font-weight: 800;\n  font-size: 1.2rem;\n  text-transform: uppercase;\n  transition: border-color 0.3s ease;\n}\n\n.sport-card:hover {\n  border-color: var(--neon-cyan);\n}"}]}
