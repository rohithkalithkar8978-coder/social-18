lor: var(--accent-red) !important; background: rgba(30, 36, 50, 0.98) !important; box-shadow: 0 15px 35px rgba(0,0,0,0.7), 0 0 25px var(--accent-red-glow); }\n.card-number { font-size: 0.85rem; font-weight: 800; color: var(--accent-red) !important; }\n.card-title { font-size: 1.8rem; font-weight: 800; margin: 10px 0 6px; color: #ffffff !important; }\n.card-tagline { font-size: 0.95rem; color: var(--text-muted) !important; line-height: 1.4; }\n.card-arrow { align-self: flex-end; font-size: 1.4rem; color: var(--accent-red) !important; }\n\n/* Detail Page Panel \u0026 Bubbles */\n.apple-glass-panel { background: rgba(16, 22, 34, 0.92); border: 1px solid var(--glass-border); backdrop-filter: blur(30px); border-radius: 36px; padding: 48px; box-shadow: 0 40px 80px rgba(0,0,0,0.9); }\n.category-pill { font-size: 0.75rem; font-weight: 800; color: var(--accent-red); letter-spacing: 2px; }\n.sport-title-hero { font-size: 3.5rem; font-weight: 900; margin: 12px 0 6px; color: #ffffff !important; }\n.tagline-sub { font-size: 1.2rem; color: var(--text-muted) !important; }\n\n.panel-body { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 36px 0; text-align: left; }\n.info-card-bubble { background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border); border-radius: 24px; padding: 24px; backdrop-filter: blur(10px); }\n.bubble-icon { font-size: 1.8rem; margin-bottom: 12px; }\n.info-card-bubble h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: #ffffff !important; }\n.info-card-bubble p, .info-card-bubble ul { color: var(--text-muted) !important; font-size: 0.95rem; line-height: 1.6; }\n.info-card-bubble ul { list-style-position: inside; padding-left: 0; }\n\n.btn-primary-glow { display: inline-block; padding: 16px 36px; background: var(--accent-red) !important; color: #ffffff !important; text-decoration: none !important; font-weight: 800; border-radius: 30px; box-shadow: 0 0 25px var(--accent-red-glow); transition: all 0.3s ease; border: none; cursor: pointer; }\n.btn-primary-glow:hover { transform: scale(1.04); box-shadow: 0 0 35px rgba(255, 42, 42, 0.8); }\n\n/* Registration Modal */\n.modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: 0.3s ease; z-index: 2000; }\n.modal-overlay.active { opacity: 1 !important; pointer-events: all !important; }\n.modal-card { background: #161b26; border: 1px solid rgba(255,255,255,0.2); width: 90%; max-width: 480px; padding: 36px; border-radius: 28px; position: relative; text-align: left; color: #fff; }\n.modal-close { position: absolute; top: 18px; right: 22px; background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; }\n.reg-form { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; }\n.reg-form input, .reg-form select { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.18); padding: 14px; border-radius: 12px; color: #fff; font-size: 0.95rem; outline: none; }\n.reg-form select option { background: #161b26; color: #fff; }\n.form-row { display: flex; gap: 12px; }\n.form-row input { flex: 1; width: 50%; }\n.submit-btn { margin-top: 10px; width: 100%; font-size: 1rem; }"}]}
